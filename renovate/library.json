{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "packageRules": [
    {
      "matchUpdateTypes": ["pin", "pinDigest", "digest"],
      "commitMessagePrefix": "📌",
      "commitMessageAction": "Pin"
    },
    {
      "matchUpdateTypes": ["rollback"],
      "commitMessagePrefix": "⬇️",
      "commitMessageAction": "Downgrade"
    },
    { "matchUpdateTypes": ["patch"], "automerge": true },
    { "matchUpdateTypes": ["lockFileMaintenance"], "minimumReleaseAge": null },
    {
      "description": "Update the Node.js version in mise.toml and @types/node together",
      "groupName": "node",
      "matchPackageNames": ["node", "@types/node"],
      "matchManagers": ["mise", "npm"],
      "matchUpdateTypes": ["major"]
    }
  ],
  "commitMessagePrefix": "⬆️",
  "commitMessageAction": "Upgrade",
  "dependencyDashboardTitle": "📌 Dependency Dashboard",
  "labels": ["📌 Dependencies"],
  "dependencyDashboardLabels": ["📌 Dependencies"],
  "lockFileMaintenance": { "enabled": true, "automerge": true },
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": { "minimumReleaseAge": null }
}
